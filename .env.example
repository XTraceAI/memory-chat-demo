# Copy to .env.local and fill in.

# xtrace memory service — get these at https://app.xtrace.ai
XTRACE_API_KEY=xtk_...
XTRACE_ORG_ID=...

# OpenAI (Vercel AI SDK provider)
OPENAI_API_KEY=sk-...

# Optional — point at a non-production deployment (e.g. staging)
# XTRACE_BASE_URL=https://api.staging.xtrace.ai

# Optional — override the shared trip conversation id
# DEMO_CONV_ID=tokyo-trip-2026
