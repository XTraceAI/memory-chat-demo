# Copy to .env.local and fill in.

# xtrace memory service
XTRACE_API_KEY=xtk_...
XTRACE_ORG_ID=...
# Defaults to https://api.staging.xtrace.ai
# XTRACE_BASE_URL=https://api.xtrace.ai

# OpenAI (Vercel AI SDK provider)
OPENAI_API_KEY=sk-...

# Optional — overrides the hardcoded demo identity
# DEMO_USER_ID=demo-user
# DEMO_CONV_ID=demo-conv
